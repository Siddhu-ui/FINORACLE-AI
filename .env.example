# ============================================================
# FinOracle AI — Self-Contained Environment Configuration
# Zero external DB setup required (auto-creates SQLite DB at backend/data/finoracle.db)
# ============================================================

# FastAPI JWT Authentication (Backend only)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRE_HOURS=168

# Optional custom SQLite DB path (defaults to backend/data/finoracle.db)
# FINORACLE_DB_PATH=backend/data/finoracle.db

# LLM Provider (Backend only — supports "gemini" or "openai")
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LLM_MODEL=gemini-2.5-flash

# Embedding Provider for Local SQLite + NumPy RAG (defaults to LLM_PROVIDER)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
RAG_SIMILARITY_THRESHOLD=0.35

# Backend & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Base URL (defaults to /api via Vite proxy in dev)
VITE_API_BASE_URL=/api
