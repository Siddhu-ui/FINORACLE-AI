{
  "name": "finoracle-ai-monorepo",
  "private": true,
  "description": "Root convenience scripts forwarding to frontend/",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test",
    "typecheck": "npm --prefix frontend exec tsc -- --noEmit",
    "install:frontend": "npm --prefix frontend install"
  }
}
